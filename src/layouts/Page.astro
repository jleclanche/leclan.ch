---
const { frontmatter, headings } = Astro.props;
const h1 = headings?.find((h) => h.depth === 1);
const title = h1?.text ?? frontmatter?.title ?? "leclan.ch";
---

<!doctype html>
<html>
	<head>
		<title>{title}</title>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, minimum-scale=1.0"
		/>
		<style>
			body {
				color: #444;
				line-height: 1.6;
				font-size: 18px;
				margin: 40px auto;
				max-width: 650px;
				padding: 0 10px;
			}
			h1,
			h2,
			h3 {
				line-height: 1.2;
			}
			a {
				color: #4183c4;
			}
			code {
				background: #f4f4f4;
				padding: 2px 6px;
				border-radius: 3px;
				font-size: 0.9em;
			}
			pre code {
				display: block;
				padding: 12px;
				overflow-x: auto;
			}
			blockquote {
				border-left: 3px solid #ccc;
				margin-left: 0;
				padding-left: 1em;
				color: #666;
			}
			footer,
			footer a {
				color: #999;
				font-size: x-small;
				margin-top: 4em;
				text-align: center;
				text-decoration: none;
			}
			footer a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<article>
			<slot />
		</article>
		<footer>
			<a href="/">Jerome @ Leclanche</a>
		</footer>
	</body>
</html>
